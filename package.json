{
  "name": "microvern-x402",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:docs": "node scripts/build-docs.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:mcp": "node dist/mcp-server.js",
    "test": "vitest run",
    "verify:mainnet-preflight": "npm run build && node dist/mainnet-preflight.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/server": "^2.1.0",
    "@x402/avm": "2.27.0",
    "@x402/core": "2.27.0",
    "@x402/extensions": "2.27.0",
    "@x402/fetch": "2.27.0",
    "@x402/hono": "2.27.0",
    "algorand-msgpack": "1.1.0",
    "algosdk": "3.7.0",
    "hono": "4.13.8",
    "pg": "8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@perawallet/connect": "^1.6.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "esbuild": "^0.27.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
