# Testnet is the default network. This file must never contain a private key.
MICROVERN_PAYMENT_NETWORK=testnet
AVM_ADDRESS=OA4GZEYO2CIOSLTQ4KE4OFSIYGPS2GDG4IMKBXH7BIZ6KCCGWTE5KWL3QE
FACILITATOR_URL=https://facilitator.goplausible.xyz
MICROVERN_PRICE_USD=$0.01
# MainNet configuration additionally requires this exact confirmation value and
# remains blocked until a durable shared idempotency store is implemented.
# MICROVERN_PAYMENT_NETWORK=mainnet
# MICROVERN_MAINNET_CONFIRMATION=ENABLE_MAINNET_PAYMENTS
# Required for MainNet: a Render Postgres Internal Database URL, kept only in
# Render's secret environment settings (never commit this value).
# MICROVERN_POSTGRES_URL=postgresql://...
# Optional locally. Set this to MicroVern's real public HTTPS icon before production discovery.
# MICROVERN_ICON_URL=https://api.example.com/microvern-icon.svg
# Required for public Bazaar cataloging behind a TLS-terminating proxy such as Render.
# This must be the HTTPS origin only, with no path or query string.
# MICROVERN_PUBLIC_BASE_URL=https://microvern-x402-mainnet.onrender.com
PORT=4021
